generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlanningLevel {
  YEAR
  SIX_MONTH
  QUARTER
  MONTH
  WEEK
  DAY
}

enum TaskLinkType {
  IMPORTED
  BROKEN_DOWN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  timezone      String    @default("UTC")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
  tasks    Task[]

  @@index([email])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// A single task, living at exactly one planning level and period.
/// `sourceTaskId` + `sourceLinkType` preserve the explicit relationship
/// created by "Import" or "Break Down" without duplicating the source task.
model Task {
  id          String        @id @default(cuid())
  userId      String
  level       PlanningLevel
  periodKey   String
  order       Float         @default(0)
  title       String
  description Json?

  completed   Boolean   @default(false)
  completedAt DateTime?

  estimatedMinutes Int?
  scheduledDate    String?
  scheduledTime    String?
  remindAt         DateTime?

  sourceTaskId   String?
  sourceLinkType TaskLinkType?

  skippedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTask Task?     @relation("TaskDerivation", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  derived    Task[]    @relation("TaskDerivation")
  subtasks   Subtask[]

  @@index([userId, level, periodKey, deletedAt])
  @@index([userId, scheduledDate])
  @@index([sourceTaskId])
  @@map("tasks")
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  completed Boolean  @default(false)
  order     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtasks")
}
